Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 600
Visualization Manager:
  Class: ~
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Plane Cell Count: 50
      Cell Size: 0.5
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
      Alpha: 0.5
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Show Axes: true
      Show Names: true
      Show Arrows: true
      Marker Scale: 0.3
      Frame Timeout: 15
      Frames:
        All Enabled: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Value: true
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Spheres
      Size (m): 0.06
      Color Transformer: FlatColor
      Color: 255; 25; 0
      Alpha: 1
      Decay Time: 0
      Use Fixed Frame: true
      Position Transformer: XYZ
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Enabled: true
  Name: root
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 80
      Enable Stereo Rendering:
        Stereo Type: ~
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Point Fixed Frame: ~
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.6
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.5
    Saved:
      - Class: rviz_default_plugins/Orbit
        Distance: 80
        Enable Stereo Rendering:
          Stereo Type: ~
          Value: false
        Focal Point:
          X: 0
          Y: 0
          Z: 0
        Focal Point Fixed Frame: ~
        Invert Z Axis: false
        Name: Orbit
        Near Clip Distance: 0.01
        Pitch: 0.6
        Target Frame: <Fixed Frame>
        Value: Orbit (rviz)
        Yaw: 0.5
      - Class: rviz_default_plugins/TopDownOrtho
        Enable Stereo Rendering:
          Stereo Type: ~
          Value: false
        Invert Z Axis: false
        Name: TopDownOrtho
        Near Clip Distance: 0.01
        Target Frame: <Fixed Frame>
        Value: TopDownOrtho (rviz)
        X: 3
        Y: 0
        Z: 15
        Yaw: 0
        Scale: 30
Window Geometry:
  Height: 800
  Width: 1200
  X: 50
  Y: 50
