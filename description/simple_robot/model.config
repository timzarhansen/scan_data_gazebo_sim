<?xml version="1.0"?>
<model>
  <name>simple_robot</name>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Simple differential-drive robot with 360° LiDAR for scan-matching dataset generation.
    Circular chassis, two driven wheels, one passive caster, 720-beam LiDAR at 10 Hz.
  </description>
